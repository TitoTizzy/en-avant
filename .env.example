# ============================================================
# EN AVANT — Variables d'environnement (Vercel > Settings > Environment Variables)
# Copier en `.env` pour le dev local (`vercel dev`). NE JAMAIS COMMITER `.env`.
# ============================================================

# --- Site ---
# URL publique du site (utilisée pour les redirections Stripe)
SITE_URL=https://enavant.org

# --- Supabase ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé publique (la SEULE autorisée côté frontend, RLS activée)
SUPABASE_ANON_KEY=
# Clé service_role — STRICTEMENT serveur (bypasse la RLS). Jamais côté client.
SUPABASE_SERVICE_ROLE_KEY=

# Secret aléatoire long utilisé pour signer le cookie PIN SuperAdmin.
# Générer au moins 32 octets aléatoires ; serveur uniquement.
ADMIN_PIN_COOKIE_SECRET=

# --- Stripe ---
# Clé secrète — serveur uniquement
STRIPE_SECRET_KEY=
# Secret de signature du webhook (Dashboard Stripe > Webhooks > /api/webhooks/stripe)
STRIPE_WEBHOOK_SECRET=
# Clé publiable — la seule clé Stripe utilisable côté client si besoin
STRIPE_PUBLISHABLE_KEY=

# --- Anthropic (génération Trivia, serveur uniquement) ---
ANTHROPIC_API_KEY=

# --- ElevenLabs (Text-to-Speech, serveur uniquement) ---
ELEVENLABS_API_KEY=
# Voix utilisée pour la lecture des articles (ID de voix ElevenLabs)
ELEVENLABS_VOICE_ID=

# --- Resend (emails transactionnels : envoi du Livre Blanc) ---
RESEND_API_KEY=
RESEND_FROM="En Avant <contact@enavant.org>"

# --- Livre Blanc ---
# Chemin du texte source dans le bucket privé `documents` (pour /api/trivia/generate)
LIVRE_BLANC_TEXT_PATH=livre-blanc.txt
# Chemin du PDF dans le bucket privé `documents` (lien signé envoyé par email)
LIVRE_BLANC_PDF_PATH=livre-blanc.pdf
