{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/trivia.js": { "maxDuration": 60 }
  },
  "redirects": [
    { "source": "/register", "destination": "/adherer", "permanent": true },
    { "source": "/register.html", "destination": "/adherer", "permanent": true }
  ],
  "crons": [
    { "path": "/api/cron/digest", "schedule": "0 12 * * *" }
  ],
  "rewrites": [
    { "source": "/api/auth/login",        "destination": "/api/auth?action=login" },
    { "source": "/api/auth/forgot",       "destination": "/api/auth?action=forgot" },
    { "source": "/api/auth/logout",       "destination": "/api/auth?action=logout" },
    { "source": "/api/auth/verify-pin",   "destination": "/api/auth?action=verify-pin" },
    { "source": "/api/auth/touch-pin",    "destination": "/api/auth?action=touch-pin" },
    { "source": "/api/auth/change-pin",   "destination": "/api/auth?action=change-pin" },
    { "source": "/sitemap.xml",           "destination": "/api/articles?format=sitemap" },
    { "source": "/api/admin/dashboard",   "destination": "/api/admin?action=dashboard" },
    { "source": "/api/admin/notifications", "destination": "/api/admin?action=notifications" },
    { "source": "/api/admin/push",        "destination": "/api/admin?action=push" },
    { "source": "/api/admin/stats",       "destination": "/api/admin?action=stats" },
    { "source": "/api/admin/articles",    "destination": "/api/admin?action=articles" },
    { "source": "/api/admin/events",      "destination": "/api/admin?action=events" },
    { "source": "/api/admin/media",       "destination": "/api/admin?action=media" },
    { "source": "/api/admin/team",        "destination": "/api/admin?action=team" },
    { "source": "/api/admin/trivia",      "destination": "/api/admin?action=trivia" },
    { "source": "/api/admin/integrations","destination": "/api/admin?action=integrations" },
    { "source": "/api/admin/settings",    "destination": "/api/admin?action=settings" },
    { "source": "/api/admin/users",       "destination": "/api/admin?action=users" },
    { "source": "/api/cron/digest",       "destination": "/api/admin?action=digest" },
    { "source": "/api/trivia/answer", "destination": "/api/trivia?action=answer" },
    { "source": "/api/trivia/questions",  "destination": "/api/trivia?action=questions" },
    { "source": "/api/trivia/score",      "destination": "/api/trivia?action=score" },
    { "source": "/api/trivia/generate",   "destination": "/api/trivia?action=generate" },
    { "source": "/api/trivia/generate-session", "destination": "/api/trivia?action=generate-session" },
    { "source": "/api/member/articles",         "destination": "/api/member?action=articles" },
    { "source": "/api/member/adhesion",         "destination": "/api/member?action=adhesion" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://cdn.jsdelivr.net/npm/@supabase/ https://cdn.quilljs.com https://cdn.gtranslate.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://cdn.quilljs.com https://cdn.jsdelivr.net/npm/quill@1.3.7/; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; connect-src 'self' https://rgtzwnihabkpudhwiuik.supabase.co wss://rgtzwnihabkpudhwiuik.supabase.co https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://analytics.google.com https://stats.g.doubleclick.net https://www.google.com https://translate-pa.googleapis.com; frame-src https://www.tiktok.com https://www.youtube.com https://www.youtube-nocookie.com; media-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    },
    {
      "source": "/pictures/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/admin-sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
